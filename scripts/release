#!/usr/bin/env bash
# Cut a release: set MARKETING_VERSION to the next semantic version, run the tests, commit,
# tag vX.Y.Z and push. The tag triggers .github/workflows/release.yml, which builds the DMG and
# publishes the GitHub release.
#
#   scripts/release patch|minor|major      bump from the current version
#   scripts/release 1.4.0 | 2.0.0-beta.1   an explicit version (no lower than the current one)
#   scripts/release … --yes                push without asking
set -euo pipefail
cd "$(dirname "$0")/.."

die() { echo "release: $*" >&2; exit 1; }

config=Config/Lucente.xcconfig
semver='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$'

bump=${1:-}
[ -n "$bump" ] || die "usage: scripts/release patch|minor|major|X.Y.Z [--yes]"
assume_yes=false
[ "${2:-}" = "--yes" ] && assume_yes=true

current=$(sed -n 's/^MARKETING_VERSION *= *//p' "$config")
[[ $current =~ $semver ]] || die "current version '$current' in $config isn't semver"
IFS=. read -r major minor patch <<< "${current%%-*}"

case $bump in
  major) next="$((major + 1)).0.0" ;;
  minor) next="$major.$((minor + 1)).0" ;;
  patch) next="$major.$minor.$((patch + 1))" ;;
  *) next=$bump ;;
esac
[[ $next =~ $semver ]] || die "'$next' isn't a semantic version (MAJOR.MINOR.PATCH[-prerelease])"
if [ "$next" != "$current" ] && [ "$(printf '%s\n%s\n' "$current" "$next" | sort -V | tail -1)" != "$next" ]; then
  die "$next is lower than the current version $current"
fi

[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || die "release from main"
git diff --quiet && git diff --cached --quiet || die "commit or stash your changes first"
git fetch --quiet --tags origin
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || die "main isn't in sync with origin/main"
! git rev-parse -q --verify "refs/tags/v$next" >/dev/null || die "tag v$next already exists"

echo "release: $current → $next"
make --no-print-directory test

if [ "$next" != "$current" ]; then
  perl -pi -e "s/^MARKETING_VERSION *=.*/MARKETING_VERSION = $next/" "$config"
  git commit --quiet -m "release: v$next" -- "$config"
fi
git tag -a "v$next" -m "Lucente $next"

if ! $assume_yes; then
  read -r -p "Push main and v$next to origin (this publishes the release)? [y/N] " answer
  [[ $answer =~ ^[Yy]$ ]] || { echo "Not pushed. To undo: git tag -d v$next && git reset --hard origin/main"; exit 0; }
fi
git push --quiet origin main "v$next"
echo "release: pushed v$next — the release workflow is building the DMG:"
echo "  https://github.com/$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || echo '<owner>/<repo>')/actions"
